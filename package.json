{
  "name": "jingsao",
  "version": "0.2.0",
  "description": "鲸扫：基于 dsh-pet 的鲸鱼娘桌宠，新增 C 盘清理（垃圾清理、微信QQ专清、重复文件、大文件搬家、软件搬家），删除前逐个复核、风险项就地确认，系统目录整批提权一次，搬家可搬回。",
  "icon": "assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "web-ui",
    "cordis",
    "react",
    "disk-cleanup",
    "c-drive",
    "whale-girl"
  ],
  "homepage": "https://github.com/aliangAI-Lab/jingsao#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliangAI-Lab/jingsao.git"
  },
  "bugs": {
    "url": "https://github.com/aliangAI-Lab/jingsao/issues"
  },
  "_comment": [
    "=============== jingsao 包清单说明 ===============",
    "type: module —— 本包是 ESM",
    "main: lib/index.js —— 宿主半侧入口（Cordis 插件：name/inject/apply）",
    "icon —— 插件图标（DSH 插件管理页显示）：相对 package.json 的图片路径，只认 svg/png/jpg/jpeg/webp，≤256 KiB，realpath 后必须留在包目录内；读取方是 dsh-app-boot 的 iconOf，会内联成 base64 data URL 塞进 meta.icon",
    "exports['./client'] —— 浏览器半侧入口，DSH 模块系统按它提供 /plugins/jingsao/client.js",
    "dsh.bundle.patch —— 声明本包是 bundle，patch 文件是 cordis.patch.yml（安装后自动进层栈）",
    "dsh.client —— 声明浏览器半侧的注入依赖和平台（web）",
    "dsh.compatibility.dshReleases —— 对官方 DSH 完整版本逐项声明 compatible/incompatible/unknown；只写宽泛范围不算证据，商城最新三版至少需要一个 compatible。列表只保最新三版，新增一版就删最旧一版：DSH 自己只按 engines.dsh 与 peerDependencies 判定能不能装，这份列表不进安装闸门，无限叠加只会变成维护负担",
    "files —— npm publish 只发这些目录/文件（assets/webm 播放资源（VP9-alpha，浏览器 Chrome/Edge/Firefox 与桌面模式共用）；Safari/HEVC 兼容由仓库流水线支持、fork 定制，不随包发布）",
    "scripts.encode:webm —— 转码管线（step03 母版 → assets/webm 640×360 VP9-alpha）",
    "scripts.build —— 构建完整产物 + files 收敛（node scripts/prepare.js）。克隆后手动跑一次；npm publish / npm pack 由 prepack 自动调用",
    "scripts.release:check —— 发布前手动跑的检查链（原 dsh-pet 的 prepack）。鲸扫把构建好的 lib/ 直接提交进仓库、用 github: 地址安装；npm/pnpm 安装 git 依赖时会触发 prepack，而观众机器上没有开发依赖，所以这里不能叫 prepack",
    "bin.jingsao-standalone —— 独立模式 CLI（构建产物 lib/standalone.js）：不打开 DSH 直接跑桌宠，把插件的宿主半边跑在伪 ctx 上；tsdown 的第二个入口负责构建，源码见 src/standalone/",
    "peerDependencies —— 运行时由宿主（DSH）提供的模块，本包不打包它们",
    "engines —— Node.js 兼容下限（由运行依赖 @electron/get@5.1.0 的 engines 决定）",
    "================================================"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "jingsao-standalone": "lib/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/webm",
    "runtime/electron-helper",
    "assets/fonts",
    "assets/pic",
    "assets/sound",
    "assets/config.jsonc",
    "assets/logo.png",
    "assets/main-character.png",
    "scripts/ensure-electron.mjs",
    "cordis.patch.yml",
    "skills"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "watch": "tsdown --watch",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "standalone": "node lib/standalone.js",
    "start:app": "node scripts/start-app.mjs",
    "dist": "node scripts/dist.mjs",
    "dev:mock": "node scripts/dev/mock-server.mjs",
    "dev:subpath": "node scripts/dev/subpath-proxy.mjs",
    "build": "node scripts/prepare.js",
    "check:openapi": "node scripts/check-openapi.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "types": "node scripts/gen-types.mjs",
    "lint": "eslint .",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/*.test.mjs",
    "check:runtime": "eslint --config eslint.runtime.config.js runtime/electron-helper",
    "release:check": "npm run build && npm run typecheck && npm run lint && npm run check:cycles && npm run check:runtime && npm run format:check && node scripts/prepack-check.js && npm run check:openapi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.9.1",
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.2-alpha.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
